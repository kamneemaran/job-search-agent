{
  "mcpServers": {
    "job-search-agent": {
      "command": "/Users/kamnee.maran/Downloads/job-search-agent/.venv/bin/python",
      "args": [
        "/Users/kamnee.maran/Downloads/job-search-agent/mcp_server.py"
      ],
      "env": {}
    },
    "rezi": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://api.rezi.ai/mcp"
      ],
